{
  "name": "snapdiff",
  "version": "1.0.0",
  "description": "Self-hosted visual regression testing engine with WebAssembly pixel diffing, responsive multi-breakpoint capture, and interactive review studio.",
  "type": "module",
  "bin": {
    "snapdiff": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "web/dist"
  ],
  "scripts": {
    "build": "npm run build:cli && npm run build:web",
    "build:cli": "tsc -p tsconfig.json",
    "build:web": "npm --prefix web run build",
    "dev:cli": "tsx src/cli.ts",
    "dev:web": "npm --prefix web run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "visual-regression",
    "visual-testing",
    "screenshot-testing",
    "regression-testing",
    "pixelmatch",
    "webassembly",
    "playwright",
    "fastify",
    "react19",
    "diff-engine",
    "ci-cd"
  ],
  "author": "Alexandr Motologa",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "commander": "^13.1.0",
    "fastify": "^5.2.1",
    "open": "^10.1.0",
    "picocolors": "^1.1.1",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.50.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
